generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("SALES_EXECUTIVE")
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  leads        Lead[]        @relation("AssignedLeads")
  activities   LeadActivity[]
  auditLogs    AuditLog[]
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  description  String?
  displayOrder Int        @default(0)
  properties   Property[]
  leads        Lead[]
  createdAt    DateTime   @default(now())
}

model City {
  id             String     @id @default(cuid())
  name           String     @unique
  slug           String     @unique
  state          String     @default("Delhi NCR")
  heading        String?
  tagline        String?
  description    String?
  isFeatured     Boolean    @default(false)
  displayOrder   Int        @default(0)
  seoTitle       String?
  seoDescription String?
  localities     Locality[]
  properties     Property[]
  leads          Lead[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Locality {
  id             String     @id @default(cuid())
  cityId         String
  city           City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  heading        String?
  subheading     String?
  pincode        String?
  description    String?
  displayOrder   Int        @default(0)
  seoTitle       String?
  seoDescription String?
  properties     Property[]
  createdAt      DateTime   @default(now())

  @@unique([cityId, slug])
}

model Builder {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  description  String?
  logoUrl      String?
  website      String?
  reraNo       String?
  properties   Property[]
  createdAt    DateTime   @default(now())
}

model Property {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  description        String
  shortDescription   String?
  price              Float
  priceDisplay       String
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id])
  purpose            String            @default("SALE")
  propertyType       String
  bedrooms           Int?
  bathrooms          Int?
  balconies          Int?
  carpetArea         Float?
  superArea          Float?
  areaUnit           String            @default("SQ_FT")
  furnishing         String?           @default("UNFURNISHED")
  possessionStatus   String?           @default("READY_TO_MOVE")
  possessionDate     String?
  reraId             String?
  verifiedStatus     Boolean           @default(true)
  featuredStatus     Boolean           @default(false)
  availabilityStatus String            @default("AVAILABLE")
  address            String
  localityId         String?
  locality           Locality?         @relation(fields: [localityId], references: [id])
  cityId             String
  city               City              @relation(fields: [cityId], references: [id])
  latitude           Float?
  longitude          Float?
  pinCode            String?
  builderId          String?
  builder            Builder?          @relation(fields: [builderId], references: [id])
  projectName        String?
  
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  isIndexable        Boolean           @default(true)
  published          Boolean           @default(true)
  viewCount          Int               @default(0)
  faqs               Json?

  images             PropertyImage[]
  amenities          PropertyAmenity[]
  leads              Lead[]
  siteVisits         SiteVisit[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model PropertyImage {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url          String
  alt          String
  caption      String?
  isFeatured   Boolean  @default(false)
  displayOrder Int      @default(0)
  imageType    String   @default("GALLERY")
  createdAt    DateTime @default(now())
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  slug       String            @unique
  icon       String?
  category   String            @default("GENERAL")
  properties PropertyAmenity[]
  createdAt  DateTime          @default(now())
}

model PropertyAmenity {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Lead {
  id             String         @id @default(cuid())
  name           String
  phone          String
  email          String?
  message        String?
  propertyId     String?
  property       Property?      @relation(fields: [propertyId], references: [id])
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  cityId         String?
  city           City?          @relation(fields: [cityId], references: [id])
  assignedToId   String?
  assignedTo     User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  status         String         @default("NEW")
  source         String         @default("WEBSITE")
  notes          String?
  activities     LeadActivity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  notes     String
  createdAt DateTime @default(now())
}

model SiteVisit {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  preferredDate DateTime
  preferredTime String
  status       String    @default("SCHEDULED")
  notes        String?
  createdAt    DateTime  @default(now())
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  subtitle       String?
  badgeText      String?
  targetUrl      String?
  ctaText        String?
  imageUrlDesktop String
  imageUrlMobile  String?
  displayOrder   Int       @default(0)
  placement      String    @default("HOMEPAGE_HERO")
  isActive       Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  summary        String?
  content        String
  featuredImage  String?
  author         String    @default("Editorial Team")
  category       String    @default("Real Estate Trends")
  tags           String?
  readTime       String    @default("5 min read")
  isPublished    Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("General")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
